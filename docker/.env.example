# ── Credenciales de la base de datos ─────────────────────────────────────────
# Copiar este fichero a .env y ajustar los valores antes de levantar el stack
POSTGRES_DB=web_auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=cambia_esto_en_produccion

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Puerto del host donde se expondrá el dashboard (http://localhost:DASHBOARD_PORT)
DASHBOARD_PORT=8080

# ── Scraper ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Segundos entre ejecuciones en modo daemon (0 = ejecutar una sola vez y salir)
# Ejemplo para análisis diario: RUN_INTERVAL_SECONDS=86400
RUN_INTERVAL_SECONDS=0
