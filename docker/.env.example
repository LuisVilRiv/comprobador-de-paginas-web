# ── Credenciales de la base de datos ─────────────────────────────────────────
POSTGRES_DB=web_auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=cambia_esto_en_produccion

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── Scraper Core ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RUN_INTERVAL_SECONDS=3600
REQUEST_TIMEOUT=15
MAX_RETRIES=3

# ── Selenium Configuration ────────────────────────────────────────────────────
SELENIUM_HEADLESS=true
SELENIUM_IMPLICIT_WAIT=5
SELENIUM_PAGE_LOAD_TIMEOUT=30

# ── Auditor Business Logic ────────────────────────────────────────────────────
AUDIT_MIN_WORD_COUNT=150
AUDIT_MAX_LINKS=40
AUDIT_MAX_DEPTH=1
AUDIT_REQUEST_DELAY=0.35
AUDIT_BUTTONS_ENABLED=true
AUDIT_JS_LOGS_ENABLED=true
AUDIT_BANNED_HOSTS=apdigroup.com,81.0.54.124
AUDIT_MAX_BROWSER_CONFIRMS=15

# ── Audit Thresholds ──────────────────────────────────────────────────────────
AUDIT_SCORE_EXCELLENT=85
AUDIT_SCORE_GOOD=70
AUDIT_RELEASE_GATE_MIN_SCORE=70
